# Copy to .env.local and fill in. Only MONGODB_URI and JWT_SECRET are required
# to run locally; everything else degrades gracefully when unset.

# MongoDB connection string. Use a local instance or your own Atlas cluster.
MONGODB_URI=mongodb://localhost:27017/pink-stem

# Secret used to sign session cookies. Any long random string.
#   openssl rand -base64 48
JWT_SECRET=

# Public base URL, used in emails and certificate verification links.
APP_URL=http://localhost:3000

# Transactional email via Resend (https://resend.com). When RESEND_API_KEY is
# unset, emails are logged to the server console instead of being sent.
RESEND_API_KEY=
EMAIL_FROM="Pink STEM Volunteer Hub <volunteer@pinkstem.org>"

# Optional Google sign-in. Leave unset to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Shared secret the scheduled job runner sends to POST /api/v1/jobs/run.
CRON_SECRET=

# First admin account created by `npm run seed`.
SEED_ADMIN_EMAIL=admin@pinkstem.org
SEED_ADMIN_PASSWORD=
