# Copy to .env.local and fill in. MONGODB_URI and JWT_SECRET are required to run
# the app; SEED_ADMIN_EMAIL and SEED_ADMIN_PASSWORD are required by `npm run seed`
# and CRON_SECRET by `npm run jobs`. Everything else degrades when unset.

# MongoDB connection string. Use a local instance or your own Atlas cluster.
MONGODB_URI=mongodb://localhost:27017/pink-stem

# Secret used to sign session cookies. Any long random string.
#   openssl rand -base64 48
JWT_SECRET=

# Public base URL, used in emails and certificate verification links.
APP_URL=http://localhost:3000

# Transactional email via Bits of Good's Juno (https://juno.bitsofgood.org).
# When JUNO_API_KEY is unset, emails are logged to the server console instead.
JUNO_API_KEY=
# Optional; defaults to https://api.juno.bitsofgood.org.
JUNO_BASE_URL=
EMAIL_FROM="Pink STEM <no-reply@pinkstem.org>"
# Optional comma list of domains or addresses that may get real email (for
# staging). Anyone else is logged instead. Unset sends to everyone.
EMAIL_ALLOWED_RECIPIENTS=

# Shared secret the scheduled job runner sends to POST /api/v1/jobs/run.
# `npm run jobs` reads it from this file. Any long random string.
CRON_SECRET=

# First admin account created by `npm run seed`. The seed exits without these.
SEED_ADMIN_EMAIL=admin@pinkstem.org
SEED_ADMIN_PASSWORD=

# Optional password for the demo accounts from `npm run seed -- demo`. Unset,
# they use the one in scripts/seed.ts. Always set it for a hosted database.
SEED_DEMO_PASSWORD=
